{
  "name": "vibeamp",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first music player with a real Winamp shell and a recommendation engine that listens to your own files.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @vibeamp/web dev",
    "build": "pnpm --filter @vibeamp/web build",
    "preview": "pnpm --filter @vibeamp/web preview",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@vibeamp/analysis": "workspace:*",
    "@vibeamp/core": "workspace:*",
    "@vibeamp/dj": "workspace:*",
    "@vibeamp/dsp": "workspace:*",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
